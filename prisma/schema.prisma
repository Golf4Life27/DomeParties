// Whitetail Ridge Golf Dome — Event Booking Engine
// Phase 1 schema: Instant Book (birthday parties) on an internal managed calendar.
// Postgres (Supabase-compatible). Money stored in integer cents.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Configuration (single row) — tunable in admin later
// ---------------------------------------------------------------------------
model Setting {
  id                  Int      @id @default(1)
  // Operating rules
  openHour            Int      @default(9)   // 9am
  closeHour           Int      @default(22)  // 10pm
  bayCapacity         Int      @default(6)   // guests per bay
  bufferMinutes       Int      @default(30)  // cleaning/turnover before & after
  leadTimeDaysOnline  Int      @default(7)   // online bookings must be >= 7 days out
  holdMinutes         Int      @default(30)  // how long an unpaid checkout hold keeps bays
  maxGolfers          Int      @default(120) // most golfers the venue can seat in bays
  maxFnbGuests        Int      @default(80)  // additional food-&-drink-only guests allowed
  staffNotifyEmail    String?               // where staff notifications go (blank = off)
  reviewUrl           String?               // public review link (e.g. Google) for post-event emails
  dayDigestSentFor    String?               // YYYY-MM-DD of the last morning digest sent
  // Money (percent values are basis-point-free integers, e.g. 10 = 10%)
  depositPercent      Int      @default(10)
  serviceChargePct    Int      @default(20)  // auto service charge on F&B + staffed portion
  serviceChargeOnGolf Boolean  @default(false) // brochure policy: 20% service charge also on golf/bay charges
  taxPct              Float    @default(7.25) // Oswego, IL placeholder — confirm exact rate
  // Dynamic pricing (applied to the package/bay-time portion)
  peakSurchargePct    Int      @default(15)  // weekend/evening premium
  offPeakDiscountPct  Int      @default(0)   // weekday/midday incentive
  cardFeePct          Float    @default(0)   // optional card convenience fee on the charge (off by default)
  // Cancellation policy (informational copy, enforced operationally)
  cancelHoursLarge    Int      @default(48)  // > cancelLargeThreshold guests
  cancelHoursSmall    Int      @default(24)
  cancelLargeThreshold Int     @default(15)
  updatedAt           DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Bookable resources: bays, specialty simulators, event/bar space
// ---------------------------------------------------------------------------
enum ResourceType {
  BAY
  SIMULATOR
  EVENT_SPACE
}

model Resource {
  id        String       @id @default(cuid())
  name      String
  type      ResourceType @default(BAY)
  floor     String?      // "Upstairs" | "Downstairs" | null
  capacity  Int          @default(6)
  active    Boolean      @default(true)
  // Exclusive = owned only by this engine (safe to instant-confirm). Shared =
  // also bookable in Trackman, so bookings need staff review to avoid conflicts.
  exclusive Boolean      @default(false)
  sortOrder Int          @default(0)

  bookings  BookingResource[]
}

// ---------------------------------------------------------------------------
// Tiered packages (Good/Better/Best), F&B packages, and add-ons
// ---------------------------------------------------------------------------
enum PricingType {
  PER_PERSON
  FLAT
  BAY_RATE // computed from the per-bay-per-hour rate engine (BayRate)
}

// Per-bay-per-hour rates, keyed by day-of-week window, time-of-day window, and a
// minimum-bays tier (so the rate steps down for larger groups). The most
// specific matching row (highest minBays) wins.
model BayRate {
  id          String  @id @default(cuid())
  label       String
  tag         String  @default("birthday") // rate set, e.g. "birthday" | "group"
  daysOfWeek  Int[]   // 0=Sun .. 6=Sat
  startMinute Int     @default(0)    // time window [start, end)
  endMinute   Int     @default(1440)
  minBays     Int     @default(1)    // applies when bays >= minBays
  minHours    Int     @default(0)    // applies when hours >= minHours (duration tier)
  ratePerHour Int     // cents per bay per hour
  flatPerBay  Int     @default(0)    // cents per bay for the whole block; overrides hourly when > 0
  active      Boolean @default(true)
  sortOrder   Int     @default(0)
}

// ---------------------------------------------------------------------------
// Operating hours — the venue's real schedule, which is also the primary
// conflict-avoidance mechanism against Trackman:
//   GOLF  hours = when Trackman sells bays → the CONTENTION window
//   PARTY hours = when we can sell events (often WIDER than golf hours; e.g.
//                 off-season Mon–Thu golf is closed but "private parties
//                 available all hours")
// A party that falls entirely outside golf hours has zero contention and can
// be confirmed instantly with certainty — no watcher, no review.
// Seasonal variants use validFrom/validTo; the most specific match wins.
// ---------------------------------------------------------------------------
enum HoursKind {
  GOLF
  PARTY
}

model OperatingHours {
  id          String    @id @default(cuid())
  label       String    // e.g. "Off-season", "Winter"
  kind        HoursKind
  dayOfWeek   Int       // 0=Sun .. 6=Sat
  closed      Boolean   @default(false)
  openMinute  Int       @default(540)  // 9:00
  closeMinute Int       @default(1320) // 22:00
  validFrom   DateTime? // seasonal window; null = applies year-round
  validTo     DateTime?
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)

  @@index([kind, dayOfWeek])
}

/// One-off closures / manual blocks (holidays, maintenance, private buyouts).
/// Also the "block this time" tool: nothing is sellable inside a closure.
model Closure {
  id          String   @id @default(cuid())
  date        DateTime // UTC-midnight of the venue day
  startMinute Int      @default(0)
  endMinute   Int      @default(1440)
  reason      String?
  createdAt   DateTime @default(now())

  @@index([date])
}

enum EventType {
  BIRTHDAY
  GROUP
  CORPORATE
  LEAGUE
  BACHELOR
  OTHER
}

// What kind of recurring relationship an Account represents. Drives nothing
// mechanical — it exists so the list can be filtered and so an outreach email
// can say "their fundraiser" rather than "their event".
enum AccountKind {
  FUNDRAISER
  CORPORATE
  CHAMBER
  BOOSTER
  MILESTONE
  OTHER
}

// ---------------------------------------------------------------------------
// Annual accounts — relationships that come back every year.
//
// Deliberately NOT tied to Booking. The events worth the most here (fundraisers
// at $8–15k, repeat corporate holiday parties) were booked by phone long before
// this app existed, so a reminder hanging off a Booking row would never fire for
// the ones that matter. This is a standalone record staff fill in from what they
// already know.
//
// Keyed on the CONTACT, not the organization: one person is routinely a personal
// customer AND the buyer for an organization's annual event, and treating those
// as separate records loses the fact that they are one relationship worth
// calling personally.
// ---------------------------------------------------------------------------
model Account {
  id           String      @id @default(cuid())
  contactName  String
  organization String? // null for a purely personal repeat customer
  contactRole  String? // "Committee chair", "HR Director" — the seat, which rotates
  email        String?
  phone        String?
  kind         AccountKind @default(OTHER)

  // When their event lands, as a month (1–12). A month, not a date: "the second
  // Thursday in March" moves every year, and the month is what outreach timing
  // actually needs.
  typicalMonth Int?

  lastEventOn     DateTime?
  lastEventValue  Int? // cents, so it matches every other money field
  lastHeadcount   Int?
  timesBooked     Int       @default(1)
  relationshipOwner String? // who at the Dome owns this — you, Billy, someone else

  // Free text, and load-bearing: this is where "also runs a summer outing at the
  // golf course" lives, since the tracker covers the Dome only.
  notes String?

  // Outreach state. nextOutreachOn is computed from typicalMonth when it's blank,
  // but staff can override it — a chair who says "ask me in June" beats arithmetic.
  nextOutreachOn   DateTime?
  lastOutreachSent DateTime?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, nextOutreachOn])
}

// ---------------------------------------------------------------------------
// Trackman coexistence: reservations pulled from the *other* booking system
// (Trackman Booking & Payments) so we can detect capacity conflicts against
// our own bookings. Fed by manual paste-import today; a scraper/API later.
// ---------------------------------------------------------------------------
model ExternalReservation {
  id           String   @id @default(cuid())
  source       String   @default("trackman")
  date         DateTime // event date (date portion, UTC-midnight of the venue day)
  startMinutes Int
  endMinutes   Int
  bayCount     Int      @default(1) // how many bays this row occupies in that window
  label        String?  // optional note (bay name/customer) from the source
  createdAt    DateTime @default(now())

  @@index([date])
}

// When a date's external reservations were last pulled, and whether it worked.
//
// ExternalReservation rows alone cannot answer this: a date with no rows is
// ambiguous between "Trackman genuinely has nothing booked" and "we have never
// managed to ask". Those two need opposite handling at checkout — the first is
// safe to instant-confirm, the second must go to staff review — so the answer
// has to be recorded rather than inferred.
model ExternalSync {
  id       String   @id @default(cuid())
  source   String   @default("trackman")
  date     DateTime // venue day (UTC-midnight, same convention as bookings)
  syncedAt DateTime @default(now())
  rowCount Int      @default(0)
  ok       Boolean  @default(true)
  error    String? // last failure reason, for the admin surface

  @@unique([source, date])
  @@index([date])
}

// A detected capacity conflict, deduped by signature so the same standing
// conflict isn't re-alerted every cron run. Resolved when it no longer appears.
model ConflictAlert {
  id         String    @id @default(cuid())
  signature  String    @unique // date + window + demand + our booking refs
  dateStr    String
  detail     String
  notifiedAt DateTime  @default(now())
  resolvedAt DateTime?
}

model Package {
  id              String      @id @default(cuid())
  name            String      // vibe-named, e.g. "The Eagle"
  tier            String      // "Good" | "Better" | "Best"
  eventType       EventType   @default(BIRTHDAY)
  description     String
  includes        String[]    // bullet list of inclusions
  durationMinutes Int         @default(120)
  bays            Int         @default(2) // bays reserved (BAY_RATE); a minimum when dynamicBays
  dynamicBays     Boolean     @default(false) // scale bays with party size (ceil(guests/cap), min `bays`)
  rateTag         String      @default("birthday") // which BayRate set to price from
  pricingType     PricingType @default(PER_PERSON)
  pricePerPerson  Int         @default(0) // cents
  flatPrice       Int         @default(0) // cents
  minGuests       Int         @default(1)
  maxGuests       Int         @default(180)
  popular         Boolean     @default(false) // "Most Popular" anchor
  active          Boolean     @default(true)
  sortOrder       Int         @default(0)

  bookings        Booking[]
}

model FnbPackage {
  id            String      @id @default(cuid())
  name          String
  description   String
  pricingType   PricingType @default(PER_PERSON)
  price         Int         @default(0) // cents (per person or flat)
  dietaryNotes  String?
  serviceCharge Boolean     @default(true) // does the 20% service charge apply
  active        Boolean     @default(true)
  sortOrder     Int         @default(0)

  bookings      Booking[]
}

enum AddOnUnit {
  FLAT
  PER_PERSON
  PER_30_MIN
}

model AddOn {
  id          String    @id @default(cuid())
  name        String
  description String
  category    String    @default("Extras") // Beverages | Food | Time | Experience | Décor | Extras
  price       Int       @default(0) // cents
  unit        AddOnUnit @default(FLAT)
  serviceCharge Boolean @default(false)
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  choiceCount Int       @default(0)  // how many items the customer picks (0 = no choice menu)
  choiceList  String[]  @default([]) // the menu they pick from (editable in admin)

  bookings    BookingAddOn[]
}

// ---------------------------------------------------------------------------
// Bookings (Instant Book) + draft capture for abandoned-cart recovery
// ---------------------------------------------------------------------------
enum BookingStatus {
  DRAFT        // email captured / in-progress (recovery target)
  PENDING      // hold placed, awaiting deposit
  CONFIRMED    // deposit paid
  CANCELLED
  COMPLETED
}

model Booking {
  id           String        @id @default(cuid())
  reference    String        @unique // human-friendly code, e.g. WTR-7F3K2
  status       BookingStatus @default(DRAFT)
  eventType    EventType     @default(BIRTHDAY)

  // Schedule
  date         DateTime      // event date (date portion)
  startMinutes Int           // minutes from midnight, e.g. 600 = 10:00
  endMinutes   Int
  partySize    Int           @default(1)  // golfers (drives bays & bay rental)
  fnbGuests    Int           @default(0)  // additional food-&-drink-only guests
  baysNeeded   Int           @default(1)

  // Selections
  packageId    String?
  package      Package?      @relation(fields: [packageId], references: [id])
  fnbPackageId String?
  fnbPackage   FnbPackage?   @relation(fields: [fnbPackageId], references: [id])
  addOns       BookingAddOn[]
  resources    BookingResource[]

  // Customer
  customerName  String?
  customerEmail String?
  customerPhone String?
  notes         String?

  // Waiver
  waiverSigned     Boolean   @default(false)
  waiverSignedName String?
  waiverGuardian   Boolean   @default(false)
  waiverSignedAt   DateTime?

  // Money (all cents)
  packageTotal  Int     @default(0)
  fnbTotal      Int     @default(0)
  addOnsTotal   Int     @default(0)
  serviceCharge Int     @default(0)
  taxAmount     Int     @default(0)
  total         Int     @default(0)
  depositAmount Int     @default(0)
  depositPaid   Boolean @default(false)
  balanceDue    Int     @default(0)
  balancePaid   Boolean @default(false)
  balancePaidAt DateTime?
  // Cumulative balance actually collected. balanceDue is what's OUTSTANDING, so
  // paying it zeroes it; without this the amount already collected was invisible
  // and an upsell added after payment resurrected it on top of the new charge.
  balancePaidAmount Int @default(0)

  // Payment
  // The DEPOSIT intent. Kept as-is rather than renamed: it is written by the
  // booking flow, read by the refund path, and matched against incoming webhooks.
  stripePaymentIntentId String?
  // The intent that actually paid the balance — a separate charge, so a separate
  // id. Without it a paid balance could not be refunded, and a chargeback on it
  // matched no booking at all, so nobody was told.
  stripeBalanceIntentId String?
  paidAt                DateTime?

  // Gift card redemption (applied to the amount due now)
  giftCardCode    String?
  giftCardApplied Int     @default(0)

  // Staff reschedule audit. A moved event looks identical to one booked for the
  // new date, which makes "the guest says you moved them" impossible to check.
  rescheduledAt       DateTime?
  rescheduledFromDate DateTime? // the date it was moved off, most recent move

  // First-touch marketing attribution (see the same fields on Lead). Captured at
  // draft creation so a booking finished days later still credits the ad that
  // started it.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  landingPath String?
  fbclid      String?
  fbp         String?
  fbc         String?

  // Abandoned-cart recovery
  recoveryEmailSentAt DateTime?

  // Conflict safety: true when the booking uses Shared bays and needs staff
  // confirmation against Trackman before it's final.
  needsReview Boolean @default(false)

  // Unpaid checkout holds release bays after this time (null = staff-managed,
  // e.g. quote bookings). Cleared on confirmation.
  holdExpiresAt DateTime?

  // Pre-event reminders (sent once each by the cron)
  reminder7SentAt DateTime?
  reviewNotifiedAt      DateTime? // last staff escalation for a stuck needs-review booking
  balanceReminderSentAt DateTime? // T-3 "settle your balance" email
  thankYouSentAt        DateTime? // post-event thank-you / review-request email
  reminder1SentAt DateTime?

  // Staged abandoned-cart recovery (0 = none sent; up to 3 touches)
  recoveryStage Int @default(0)

  // Promo code applied at checkout
  promoCode     String?
  promoDiscount Int     @default(0)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([date, status])
  @@index([status, updatedAt])
  // Refund and dispute webhooks identify a booking only by payment intent id.
  @@index([stripePaymentIntentId])
  @@index([stripeBalanceIntentId])
}

model BookingAddOn {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  addOnId   String
  addOn     AddOn   @relation(fields: [addOnId], references: [id])
  quantity  Int     @default(1)
  unitPrice Int     @default(0) // cents, snapshot at booking time
  lineTotal Int     @default(0)
  choices   String[] @default([]) // customer's picks when the add-on has a choice menu

  @@unique([bookingId, addOnId])
}

model BookingResource {
  id         String   @id @default(cuid())
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id])

  @@unique([bookingId, resourceId])
}

// ---------------------------------------------------------------------------
// Inquiry / lead capture (Phase 2 flow; table seeded now)
// ---------------------------------------------------------------------------
enum LeadStatus {
  NEW
  CONTACTED
  PROPOSAL_SENT
  WON
  LOST
}

// ---------------------------------------------------------------------------
// Gift cards (cash up front; redeemable toward the deposit at booking)
// ---------------------------------------------------------------------------
enum GiftCardStatus {
  PENDING   // purchased, awaiting payment
  ACTIVE    // paid, redeemable
  REDEEMED  // balance exhausted
  VOID
}

model GiftCard {
  id             String         @id @default(cuid())
  code           String         @unique
  initialAmount  Int // cents
  balance        Int // cents
  status         GiftCardStatus @default(PENDING)
  purchaserName  String?
  purchaserEmail String?
  recipientName  String?
  recipientEmail String?
  message        String?
  stripePaymentIntentId String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Lead {
  id            String     @id @default(cuid())
  eventType     EventType  @default(CORPORATE)
  preferredDate DateTime?
  dateFlexible  Boolean    @default(false)
  headcountMin  Int?
  headcountMax  Int?
  budget        String?
  mustHaves     String[]
  customerName  String
  customerEmail String
  customerPhone String?
  message       String?
  status        LeadStatus @default(NEW)
  source        String?    @default("website")
  followUpSentAt DateTime?

  // First-touch marketing attribution, copied from the wtr_attr cookie at
  // submission. Nullable = organic / direct / cookie blocked. This is what turns
  // "we got a lead" into "the holiday-party ad got a lead".
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  landingPath String? // first page of the visit, e.g. /holiday
  fbclid      String? // Meta click id — raises Conversions API match quality
  fbp         String? // _fbp cookie — Meta's browser id, its main browser↔server match signal
  fbc         String? // _fbc cookie — Meta's own click-id format, better than rebuilding one

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

// ---------------------------------------------------------------------------
// Promo codes (campaigns; day-of-week restriction fills weekday troughs)
// ---------------------------------------------------------------------------
model PromoCode {
  id                String    @id @default(cuid())
  code              String    @unique
  description       String    @default("")
  percentOff        Int       @default(0) // e.g. 15 = 15% (wins over amountOff)
  amountOff         Int       @default(0) // cents, used when percentOff = 0
  minTotal          Int       @default(0) // cents; booking total must reach this
  appliesDays       Int[]     // event day-of-week (0=Sun..6=Sat); empty = any day
  startsAt          DateTime?
  endsAt            DateTime?
  maxRedemptions    Int       @default(0) // 0 = unlimited
  timesRedeemed     Int       @default(0)
  featuredInRecovery Boolean  @default(false) // offered in late recovery emails
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}
