# Local dev database (Postgres running in this container)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# Stripe (TEST mode). Leave blank to use the dev simulated-payment fallback.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Email (Resend). Leave blank to log emails to the server console in dev.
RESEND_API_KEY=""
EMAIL_FROM="Whitetail Ridge Golf Dome <events@whitetailridgedome.com>"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin (change in production!)
ADMIN_PASSWORD="choose-a-strong-password"
ADMIN_SESSION_TOKEN="a-long-random-string"

# Conversion tracking (optional; blank = off)
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# MyChatBot sales widget — "Birdie" (optional; blank = no chat bubble).
# Both must be set for the widget to render. Values come from the MyChatBot
# dashboard → Channels → Website Widget.
NEXT_PUBLIC_MYCHATBOT_ACCOUNT_ID=""
NEXT_PUBLIC_MYCHATBOT_WIDGET_ID=""

# Direct (non-pooled) DB connection for migrations (Supabase port 5432).
# DATABASE_URL should be the pooled URL (port 6543) for the app itself.
DIRECT_DATABASE_URL=""

# After-hours party agent (optional; off unless DOME_AGENT="on" AND a key is set).
# Off, /api/agent answers 404 and nothing on the site changes. The model and
# effort default to claude-opus-5-5 / medium; scripts/agent-replay.ts compares.
DOME_AGENT=""
ANTHROPIC_API_KEY=""
DOME_AGENT_MODEL=""
DOME_AGENT_EFFORT=""
# "on" swaps the website chat bubble from MyChatBot to the agent (needs DOME_AGENT on too).
DOME_AGENT_WIDGET=""
# Flat booking fee in dollars for a party with no food or drinks (blank = 25, 0 = none).
GOLF_ONLY_FEE_DOLLARS=""
